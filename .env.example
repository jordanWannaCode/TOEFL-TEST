# scripts/init-local.sh génère .env ; aucune valeur secrète dans ce modèle.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
LOCAL_USER_EMAIL=
LOCAL_USER_PASSWORD=
# 0 = pratique sans limite. Une valeur différente publie une nouvelle version locale.
READING_PRACTICE_DURATION_SECONDS=0

# Durée de démonstration personnalisée, PAS une règle ETS universelle.
LISTENING_SECTION_DURATION_SECONDS=300
